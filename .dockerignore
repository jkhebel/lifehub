# flyctl launch added from .gitignore
# Dependencies
**/node_modules

# Build output
**/dist
**/*.local

# TypeScript
**/*.tsbuildinfo

# Logs and debug
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Environment and secrets
**/.env
**/.env.*
!**/.env.example

# Editor and IDE
**/.idea
**/.vscode
**/*.swp
**/*.swo
**/*~

# OS
**/.DS_Store
**/Thumbs.db

# Test and coverage
**/coverage
**/.nyc_output

# Optional: uncomment to ignore local editor/agent config
# .cursor/
fly.toml
